@model MVC_App.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<h1>Employee Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.EmpNo)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.EmpNo)</dd>
