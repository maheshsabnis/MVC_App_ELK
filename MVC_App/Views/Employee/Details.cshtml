        <dd class="col-sm-10">@Html.DisplayFor(model => model.Salary)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DeptName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.DeptName)</dd>
