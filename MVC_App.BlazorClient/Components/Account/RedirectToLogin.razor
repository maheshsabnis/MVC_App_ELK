@inject NavigationManager Navigation

@*
    Sends an anonymous visitor to the login page, carrying where they were trying to go so they
    land back there after signing in.

    forceLoad is required: the login page is static SSR (see App.razor), so it has to be fetched
    as a real navigation rather than patched in over the existing circuit.
*@

@code {
    protected override void OnInitialized()
    {
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);

        Navigation.NavigateTo(
            $"account/login?returnUrl={Uri.EscapeDataString(returnUrl)}",
            forceLoad: true);
    }
}
